{
  "expo": {
    "name": "gastos-app",
    "slug": "gastos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/icon.png",
    "scheme": "gastosapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    
    "updates": {
  "url": "https://u.expo.dev/85d79630-c6a4-4fd9-8b73-29946e9fc793",
  "enabled": true,
  "fallbackToCacheTimeout": 0,
  "checkAutomatically": "ON_LOAD"
},
    "ios": {
      "icon": "./assets/expo.icon/Assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/expo.icon/Assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.appsconcamilo.gastosapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/expo.icon/Assets/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85d79630-c6a4-4fd9-8b73-29946e9fc793"
      }
    },
    "owner": "camig"
  }
}